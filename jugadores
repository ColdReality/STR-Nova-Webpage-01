<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>STR NOVA :: Jugadores</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,900;1,700&family=Work+Sans:wght@300;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-black: #050608;
            --text-main: #ffffff;
            --text-muted: #8e9bb0;
            --hex-cyan: #00f0ff;
            --hex-gold: #c8aa6e;
            --font-display: 'Playfair Display', serif;
            --font-body: 'Work Sans', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { background-color: var(--bg-black); color: var(--text-main); font-family: var(--font-body); padding-top: 6rem; }

        nav {
            display: flex; justify-content: space-between; align-items: center;
            padding: 1.5rem 6%; background: rgba(5, 6, 8, 0.85); backdrop-filter: blur(12px);
            position: fixed; width: 100%; top: 0; z-index: 100;
            border-bottom: 1px solid rgba(200, 170, 110, 0.15);
        }

        .brand { font-family: var(--font-display); font-size: 1.8rem; font-weight: 900; color: #fff; display: flex; align-items: center; gap: 12px; }
        .brand-logo { height: 38px; width: auto; filter: invert(1) brightness(1.2); }
        .brand .sub-tag { font-family: var(--font-body); font-size: 0.75rem; color: var(--hex-gold); border: 1px solid rgba(200, 170, 110, 0.3); padding: 2px 8px; border-radius: 4px; }

        .nav-links { display: flex; gap: 2.5rem; list-style: none; }
        .nav-links a { color: var(--text-muted); text-decoration: none; font-weight: 600; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 1.5px; transition: color 0.3s; }
        .nav-links a:hover, .nav-links a.active { color: var(--hex-cyan); }

        .container { max-width: 1300px; margin: 0 auto; padding: 4rem 2rem; }
        .section-title { font-family: var(--font-display); font-size: 3.5rem; margin-bottom: 3rem; display: flex; align-items: center; gap: 20px; }
        .section-title::after { content: ""; height: 1px; flex-grow: 1; background: linear-gradient(90deg, rgba(200, 170, 110, 0.4), transparent); }

        .roster-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; }
        .tactician-card { background: rgba(15, 20, 30, 0.6); border: 1px solid rgba(200, 170, 110, 0.15); border-radius: 12px; padding: 2rem; transition: all 0.4s ease; backdrop-filter: blur(10px); }
        .tactician-card:hover { transform: translateY(-8px); border-color: var(--hex-cyan); box-shadow: 0 10px 30px rgba(0, 240, 255, 0.15); }

        .little-legend-avatar { width: 90px; height: 90px; border-radius: 50%; background: radial-gradient(circle, rgba(0,240,255,0.2) 0%, rgba(168,85,247,0.2) 100%); border: 2px solid var(--hex-gold); display: flex; align-items: center; justify-content: center; font-size: 2.5rem; margin-bottom: 1.5rem; }
        .player-rank { font-size: 0.75rem; color: var(--hex-cyan); font-weight: 800; text-transform: uppercase; margin-bottom: 0.3rem; display: block; }
        .player-alias { font-family: var(--font-display); font-size: 2.2rem; margin-bottom: 0.5rem; color: #fff; }
        .favorite-comp { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1.5rem; }
        .favorite-comp span { color: #fff; font-weight: 600; }
        .player-socials { display: flex; gap: 1rem; border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 1rem; }
        .player-socials a { color: var(--text-muted); text-decoration: none; font-size: 0.8rem; font-weight: 600; transition: color 0.3s; }
        .player-socials a:hover { color: var(--hex-gold); }
    </style>
</head>
<body>
    <nav>
        <div class="brand">
            <img src="logo.png" alt="STR Nova Logo" class="brand-logo">
            <span>STR NOVA</span>
            <span class="sub-tag">TFT</span>
        </div>
        <ul class="nav-links">
            <li><a href="index.html">Inicio</a></li>
            <li><a href="jugadores.html" class="active">Jugadores</a></li>
            <li><a href="staff.html">Staff</a></li>
        </ul>
        <a href="#discord" class="btn-nova" style="padding: 0.6rem 1.4rem; font-size: 0.8rem; text-decoration:none; color:#000; background:linear-gradient(135deg, #fff, var(--hex-gold));">DISCORD</a>
    </nav>

    <section class="container">
        <h2 class="section-title">Nuestros Jugadores</h2>
        <div class="roster-grid">
            <div class="tactician-card">
                <div class="little-legend-avatar">🦉</div>
                <span class="player-rank">CHALLENGER • 1,200 LP</span>
                <h3 class="player-alias">CYPHER</h3>
                <p class="favorite-comp">Estilo: <span>Flex Fast 8 / Reroll</span></p>
                <div class="player-socials">
                    <a href="#" target="_blank">TWITCH</a>
                    <a href="#" target="_blank">X (TWITTER)</a>
                </div>
            </div>
            <div class="tactician-card">
                <div class="little-legend-avatar">🐉</div>
                <span class="player-rank">GRANDMASTER • 650 LP</span>
                <h3 class="player-alias">NOVA</h3>
                <p class="favorite-comp">Estilo: <span>Tempo Aggro / Lose Streak</span></p>
                <div class="player-socials">
                    <a href="#" target="_blank">TWITCH</a>
                    <a href="#" target="_blank">X (TWITTER)</a>
                </div>
            </div>
        </div>
    </section>
</body>
</html>
